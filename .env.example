# ==========================
# Market Bot Configuration
# ==========================

# --- General ---
ENVIRONMENT=production
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=60
ENABLE_PAPER_TRADING=false

# --- Market Data Providers ---
# Binance is public, no key needed for spot prices
# For XAUUSD / Forex you can use TwelveData or AlphaVantage
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Assets to Monitor (comma separated, overrides config.yaml if set) ---
# Format: SYMBOL:TYPE:EXCHANGE e.g. XAUUSD:FOREX, BTCUSDT:CRYPTO:BINANCE, ETHUSDT:CRYPTO:BINANCE
MONITORED_ASSETS=XAUUSD:FOREX, BTCUSDT:CRYPTO:BINANCE, ETHUSDT:CRYPTO:BINANCE, EURUSD:FOREX

# --- Technical Indicators Config ---
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
SMA_FAST_PERIOD=50
SMA_SLOW_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
PRICE_CHANGE_ALERT_PERCENT=2.0

# --- Alert Cooldown (seconds) to prevent spam ---
ALERT_COOLDOWN_SECONDS=900

# --- Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ---
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# --- Netlify Blobs (auto-enabled on Netlify) ---
NETLIFY_BLOBS_ENABLED=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# --- State Persistence ---
STATE_FILE_PATH=./data/state.json
ALERT_HISTORY_FILE=./data/alert_history.json
